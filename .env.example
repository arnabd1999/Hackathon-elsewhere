# You.com — https://you.com/platform/api-keys
YDC_API_KEY=

# LLM: openai (default, any OpenAI-compatible server), anthropic, or you
# "you" needs only YDC_API_KEY: it uses the You.com Research API as the model.
# Use it when the key has no Inference Router credits (api.you.com/v1/chat/completions returns 402).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=

# Tuning
MAX_PAGES=14
LLM_CONCURRENCY=6
